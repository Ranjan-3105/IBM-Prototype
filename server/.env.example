NODE_ENV=development
PORT=5000
# Local MongoDB (mongodb://127.0.0.1:27017/skillbridge) or MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/skillbridge?retryWrites=true&w=majority
JWT_SECRET=<at least 32 random characters>
JWT_EXPIRES_IN=2h
# Optional: leave empty to run with deterministic fallbacks (no AI calls)
GEMINI_API_KEY=
# Use a current Flash-class model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
# Comma-separate several origins if needed (e.g. Vercel prod + preview)
CLIENT_URL=http://localhost:5173

